# UniSmart environment variables
#
# Copy this file to .env.local for local development.
# Add these on Vercel: Project -> Settings -> Environment Variables.

# Amazon Associates tag used on retailer search links (public, safe to expose).
NEXT_PUBLIC_AFFILIATE_TAG=unismart00-21

# Buttondown newsletter API key (server-only). Keep private!
# Create it at https://buttondown.com -> Settings -> API Keys.
BUTTONDOWN_API_KEY=

# Optional: tag applied to new subscribers so you can segment them in Buttondown.
BUTTONDOWN_TAG=unismart-web